{
  "name": "react-native-asleep",
  "version": "1.0.15",
  "description": "Asleep SDK for React Native",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "typecheck": "expo-module typecheck",
    "test": "expo-module test",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "react-native",
    "expo",
    "react-native-asleep",
    "Asleep"
  ],
  "repository": "https://github.com/asleep-ai/asleep-sdk-react-native",
  "bugs": {
    "url": "https://github.com/asleep-ai/asleep-sdk-react-native/issues"
  },
  "author": "Qube <qube@asleep.ai> (https://github.com/Sun-Woo-Kim)",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/asleep-ai/asleep-sdk-react-native#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "build",
    "src",
    "!src/**/__tests__",
    "ios",
    "android",
    "expo-module.config.json",
    "*.podspec",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@types/react": "^19.0.0",
    "expo-module-scripts": "^5.0.8",
    "expo-modules-core": "^1.12.19",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "zustand": "^5.0.12"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*",
    "zustand": "^5.0.1"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "@tootallnate/once@<3.0.1": ">=3.0.1",
      "@xmldom/xmldom@<0.8.13": ">=0.8.13",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "flatted@<=3.4.1": ">=3.4.2",
      "handlebars@<=4.7.8": ">=4.7.9",
      "lodash@<=4.17.23": ">=4.18.0",
      "lodash-es@<=4.17.23": ">=4.18.0",
      "node-forge@<=1.3.3": ">=1.4.0",
      "picomatch@<2.3.2": ">=2.3.2",
      "postcss": "^8.5.12",
      "undici@<6.24.0": "^6.24.0",
      "undici@>=7.0.0 <7.24.0": "^7.24.0",
      "uuid@<14.0.0": "^14.0.0",
      "yaml@<2.8.3": ">=2.8.3"
    }
  }
}
